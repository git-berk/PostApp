<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:ignore="Overdraw">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/detail_hero_height">

                <ImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_post_image"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/scrim_detail_hero" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:paddingTop="6dp"
                android:paddingBottom="60dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/title"
                        style="@style/Text.Display.Detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="sunt aut facere repellat provident occaecati" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/editTitleButton"
                        style="@style/Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="@string/edit"
                        app:drawableStartCompat="@drawable/ic_pencil" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/titleEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_edit_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Text.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_2"
                        android:labelFor="@+id/titleInput"
                        android:textColor="@color/neutral_700"
                        android:text="@string/title_label" />

                    <EditText
                        android:id="@+id/titleInput"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:lines="2"
                        android:textFontWeight="700" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/saveTitleButton"
                            style="@style/Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/save" />

                        <TextView
                            android:id="@+id/cancelTitleButton"
                            style="@style/Button.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/cancel" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.SectionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@+id/bodyInput"
                        android:text="@string/description_label" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/editBodyButton"
                        style="@style/Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit"
                        app:drawableStartCompat="@drawable/ic_pencil" />
                </LinearLayout>

                <TextView
                    android:id="@+id/body"
                    style="@style/Text.DetailBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    tools:text="quia et suscipit suscipit recusandae consequuntur expedita et cum reprehenderit molestiae ut ut quas totam" />

                <LinearLayout
                    android:id="@+id/bodyEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/bg_edit_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/bodyInput"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:lines="6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/saveBodyButton"
                            style="@style/Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/save" />

                        <TextView
                            android:id="@+id/cancelBodyButton"
                            style="@style/Button.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/cancel" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/savedPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_saved_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_4"
                    android:paddingVertical="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:fontFamily="@font/figtree"
                        android:text="@string/changes_saved"
                        android:textColor="@color/accent_2_700"
                        android:textFontWeight="600"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/bg_button_icon"
        android:contentDescription="@string/cd_back"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_left" />

    <TextView
        android:id="@+id/badge"
        style="@style/Tag.Accent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_4"
        tools:text="Post #1" />
</FrameLayout>

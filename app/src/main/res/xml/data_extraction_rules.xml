<?xml version="1.0" encoding="utf-8"?>
<!-- Posts are re-fetched on every launch and edits are intentionally in-memory,
     so there is nothing worth transferring between devices or backing up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>

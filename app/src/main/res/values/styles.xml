<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text.Display" parent="">
        <item name="android:fontFamily">@font/caprasimo</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Text.Display.Screen">
        <item name="android:textSize">34sp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="Text.Display.Detail">
        <item name="android:textSize">27sp</item>
        <item name="android:lineSpacingMultiplier">1.18</item>
    </style>

    <style name="Text.Display.Empty">
        <item name="android:textSize">26sp</item>
    </style>


    <style name="Text.RowTitle" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.RowSnippet" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textColor">@color/neutral_700</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.SectionLabel" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/neutral_600</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.DetailBody" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textColor">@color/neutral_800</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:lineSpacingMultiplier">1.32</item>
    </style>

    <style name="Text.Tag" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Tag.Neutral" parent="Text.Tag">
        <item name="android:background">@drawable/bg_tag_neutral</item>
        <item name="android:textColor">@color/neutral_800</item>
    </style>

    <style name="Tag.Accent" parent="Text.Tag">
        <item name="android:background">@drawable/bg_tag_accent</item>
        <item name="android:textColor">@color/accent_800</item>
    </style>

    <!-- Organic pills: .btn is Caprasimo at 14px with a 999px radius. -->
    <style name="Button.Base" parent="">
        <item name="android:fontFamily">@font/caprasimo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>

    <style name="Button.Primary" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/bg</item>
    </style>

    <style name="Button.Secondary" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Button.Ghost" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/accent_700</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:drawablePadding">6dp</item>
    </style>

    <style name="Input" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/neutral_500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
    </style>
    <style name="Shape.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
